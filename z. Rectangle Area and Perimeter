-> Rectangle Area and Perimeter

class Rectengle:

    def __init__(self, width, height):  // pending
        self.width = width
        self.height = height

    def area(self):
        return self.width * self.height

    def perimeter(self):
        return 2 * (self.width + self.height)


# Test
rect = Rectengle(5, 10)
print("Area:", rect.area())  # Area : 50
print("Perimeter:", rect.perimeter())  # Perameter : 30
